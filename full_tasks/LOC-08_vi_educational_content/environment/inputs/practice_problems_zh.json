    {"id": "ZH-29", "lesson": 6, "question": "解不等式组：x+1>3 且 2x<12", "answer": "2<x<6", "solution": "x>2 且 x<6，取交集2<x<6", "difficulty": 2},
    {"id": "ZH-30", "lesson": 6, "question": "一个数的3倍大于这个数加8，求这个数的范围", "answer": "x>4", "solution": "3x>x+8, 2x>8, x>4", "difficulty": 2},
    {"id": "ZH-31", "lesson": 7, "question": "写出经过点(0,3)且斜率为2的直线方程", "answer": "y=2x+3", "solution": "y=mx+b, m=2, b=3, 所以y=2x+3", "difficulty": 1},
    {"id": "ZH-32", "lesson": 7, "question": "求y=3x-6的x轴截距", "answer": "x=2", "solution": "令y=0: 0=3x-6, 3x=6, x=2", "difficulty": 2},
    {"id": "ZH-33", "lesson": 7, "question": "判断点(2,7)是否在直线y=3x+1上", "answer": "是", "solution": "代入: y=3(2)+1=7，与给定y坐标相同，在直线上", "difficulty": 1},
    {"id": "ZH-34", "lesson": 7, "question": "求两直线y=x+1和y=-x+5的交点", "answer": "(2,3)", "solution": "x+1=-x+5, 2x=4, x=2, y=3", "difficulty": 2},
    {"id": "ZH-35", "lesson": 7, "question": "已知直线经过(1,4)和(3,10)，求斜率", "answer": "3", "solution": "k=(10-4)/(3-1)=6/2=3", "difficulty": 2},
    {"id": "ZH-36", "lesson": 8, "question": "用代入法解方程组：y=x+2, y=3x-4", "answer": "x=3, y=5", "solution": "x+2=3x-4, 6=2x, x=3, y=5", "difficulty": 2},
    {"id": "ZH-37", "lesson": 8, "question": "用消元法解：x+y=7, x-y=3", "answer": "x=5, y=2", "solution": "两式相加: 2x=10, x=5, y=2", "difficulty": 2},
    {"id": "ZH-38", "lesson": 8, "question": "解方程组：2x+y=8, x-y=1", "answer": "x=3, y=2", "solution": "两式相加: 3x=9, x=3, y=2", "difficulty": 2},
    {"id": "ZH-39", "lesson": 8, "question": "鸡兔同笼：头35只，脚94只，各多少？", "answer": "鸡23只，兔12只", "solution": "设鸡x兔y: x+y=35, 2x+4y=94. x=35-y代入: 70-2y+4y=94, 2y=24, y=12, x=23", "difficulty": 3},
    {"id": "ZH-40", "lesson": 8, "question": "甲笔记本2元，乙笔记本3元，买了10本共花24元，各买几本？", "answer": "甲6本，乙4本", "solution": "x+y=10, 2x+3y=24. x=10-y: 20-2y+3y=24, y=4, x=6", "difficulty": 2},
    {"id": "ZH-41", "lesson": 9, "question": "计算：(3x²+2x-1)+(x²-3x+4)", "answer": "4x²-x+3", "solution": "3x²+x²=4x², 2x-3x=-x, -1+4=3", "difficulty": 1},
    {"id": "ZH-42", "lesson": 9, "question": "计算：(5x²-3x)-(2x²+x-4)", "answer": "3x²-4x+4", "solution": "5x²-2x²=3x², -3x-x=-4x, 0-(-4)=4", "difficulty": 2},
    {"id": "ZH-43", "lesson": 9, "question": "计算：(2x)(3x²)", "answer": "6x³", "solution": "系数相乘: 2×3=6，指数相加: x¹×x²=x³", "difficulty": 1},
    {"id": "ZH-44", "lesson": 9, "question": "计算：(-2x²y)(3xy²)", "answer": "-6x³y³", "solution": "(-2)(3)=-6, x²·x=x³, y·y²=y³", "difficulty": 2},
    {"id": "ZH-45", "lesson": 9, "question": "展开：x(x+3)", "answer": "x²+3x", "solution": "x·x+x·3=x²+3x", "difficulty": 1},
    {"id": "ZH-46", "lesson": 10, "question": "一块长方形菜地，长比宽多3米，周长为26米，求面积", "answer": "40平方米", "solution": "设宽x: 2(x+x+3)=26, 4x+6=26, x=5, 面积=5×8=40", "difficulty": 2},
    {"id": "ZH-47", "lesson": 10, "question": "连续三个整数之和为72，求这三个数", "answer": "23, 24, 25", "solution": "设中间数x: (x-1)+x+(x+1)=72, 3x=72, x=24", "difficulty": 2},
    {"id": "ZH-48", "lesson": 10, "question": "某商品打八折后售价为240元，原价多少？", "answer": "300元", "solution": "设原价x: 0.8x=240, x=300", "difficulty": 2},
    {"id": "ZH-49", "lesson": 10, "question": "甲工人每天生产15件产品，乙工人每天生产12件。两人合作几天生产270件？", "answer": "10天", "solution": "(15+12)t=270, 27t=270, t=10", "difficulty": 2},
    {"id": "ZH-50", "lesson": 10, "question": "一辆汽车从A到B用了3小时，返回时速度提高20%，返回用了多少小时？", "answer": "2.5小时", "solution": "设去时速度v, 距离=3v, 返回速度1.2v, 时间=3v/1.2v=2.5小时", "difficulty": 3}
