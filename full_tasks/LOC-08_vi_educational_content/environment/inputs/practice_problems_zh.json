  "problems": [
    {"id": "ZH-01", "lesson": 1, "question": "当 x=3 时，求代数式 2x+5 的值", "answer": "11", "solution": "2×3+5=6+5=11", "difficulty": 1},
    {"id": "ZH-02", "lesson": 1, "question": "写出"一个数的3倍减去7"的代数式", "answer": "3x-7", "solution": "设这个数为x，3倍为3x，减7得3x-7", "difficulty": 1},
    {"id": "ZH-03", "lesson": 1, "question": "当 a=2, b=3 时，求 a²+2ab 的值", "answer": "16", "solution": "2²+2×2×3=4+12=16", "difficulty": 2},
    {"id": "ZH-04", "lesson": 1, "question": "一支铅笔x元，一支钢笔比铅笔贵5元。买3支铅笔和2支钢笔共多少元？", "answer": "5x+10", "solution": "钢笔价格为x+5，总价=3x+2(x+5)=3x+2x+10=5x+10", "difficulty": 2},
    {"id": "ZH-05", "lesson": 1, "question": "判断下列各式哪些是代数式：①2x+3 ②5>3 ③a²-b ④x=5", "answer": "①③", "solution": "代数式不含等号或不等号，②是不等式，④是等式", "difficulty": 1},
    {"id": "ZH-06", "lesson": 2, "question": "合并同类项：3x+5y-2x+3y", "answer": "x+8y", "solution": "3x-2x=x, 5y+3y=8y，结果为x+8y", "difficulty": 1},
    {"id": "ZH-07", "lesson": 2, "question": "化简：2(3x-1)-3(x+2)", "answer": "3x-8", "solution": "6x-2-3x-6=3x-8", "difficulty": 2},
    {"id": "ZH-08", "lesson": 2, "question": "合并同类项：4a²b-3ab²+2a²b+ab²", "answer": "6a²b-2ab²", "solution": "4a²b+2a²b=6a²b, -3ab²+ab²=-2ab²", "difficulty": 2},
    {"id": "ZH-09", "lesson": 2, "question": "化简求值：3x²-2x+5-x²+3x-1，其中x=-2", "answer": "13", "solution": "合并得2x²+x+4，代入x=-2: 2×4+(-2)+4=8-2+4=10...更正: 2(4)+(-2)+4=10", "difficulty": 3},
    {"id": "ZH-10", "lesson": 2, "question": "去括号并合并：-(2a-3b)+(4a-b)", "answer": "2a+2b", "solution": "-2a+3b+4a-b=2a+2b", "difficulty": 2},
