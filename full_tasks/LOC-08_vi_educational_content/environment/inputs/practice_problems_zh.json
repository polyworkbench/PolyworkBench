    {"id": "ZH-19", "lesson": 4, "question": "一个数的2倍加上5等于21，求这个数", "answer": "8", "solution": "设数为x, 2x+5=21, 2x=16, x=8", "difficulty": 2},
    {"id": "ZH-20", "lesson": 4, "question": "解方程：3(x-2)=12", "answer": "x=6", "solution": "x-2=4, x=6 (或展开: 3x-6=12, 3x=18, x=6)", "difficulty": 2},
    {"id": "ZH-21", "lesson": 5, "question": "解方程：3x+4=x+10", "answer": "x=3", "solution": "3x-x=10-4, 2x=6, x=3", "difficulty": 2},
