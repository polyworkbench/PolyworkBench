{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KNW-04 Output Schema",
  "type": "object",
  "required": ["total_patents_analyzed", "whitespace_areas"],
  "properties": {
    "total_patents_analyzed": {
      "type": "integer",
      "description": "Total number of patents analyzed from EN/ZH/KO sources"
    },
    "whitespace_areas": {
      "type": ["integer", "array"],
      "description": "Number or list of identified patent whitespace areas"
    },
    "trend_categories": {
      "type": "integer",
      "description": "Number of technology trend categories identified"
    },
    "top_assignees": {
      "type": "array",
      "description": "Top patent assignees/applicants identified",
      "items": {"type": "string"}
    },
    "filing_recommendations": {
      "type": "integer",
      "description": "Number of filing recommendations made"
    }
  }
}
