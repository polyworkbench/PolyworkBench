{
  "company": "CloudMetrics Inc.",
  "platform": "CloudMetrics Analytics SaaS",
  "data_flows": [
    {
      "id": "DF-001",
      "name": "User Registration & Account Management",
      "source": "EU/EEA End Users",
      "destination": "AWS us-east-1 (Virginia, USA)",
      "data_categories": ["name", "email", "company", "job_title", "billing_info"],
      "legal_basis": "performance_of_contract",
      "transfer_mechanism": "EU-US DPF + SCCs",
      "volume": "~50,000 EU users",
      "encryption": "TLS 1.3 in transit, AES-256 at rest"
    },
    {
      "id": "DF-002",
      "name": "Behavioral Analytics Collection",
      "source": "EU/EEA End Users (browser/platform)",
      "destination": "Google Cloud us-central1 (Iowa, USA)",
      "data_categories": ["ip_address", "clickstream", "mouse_movements", "scroll_depth", "session_recordings", "search_queries"],
      "legal_basis": "legitimate_interest",
      "transfer_mechanism": "SCCs (2021)",
      "volume": "~2M events/day from EU users",
      "encryption": "TLS 1.3 in transit, AES-256 at rest",
      "tia_completed": false,
      "notes": "No individual TIA performed. General supplementary measures document exists."
    },
    {
      "id": "DF-003",
      "name": "Customer Data Processing (Platform Analytics)",
      "source": "EU/EEA Customer Uploads",
      "destination": "AWS us-east-1 (Virginia, USA)",
