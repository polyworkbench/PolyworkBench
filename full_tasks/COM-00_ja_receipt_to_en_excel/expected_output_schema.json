{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["concur_expense_csv", "extraction", "exceptions_md"],
  "properties": {
    "concur_expense_csv": {
      "type": "string",
      "description": "CSV 文本，含 BOM；列：Date,Vendor,Description,Amount_JPY,Tax_Rate,Amount_CNY,Receipt_ID"
    },
    "extraction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["receipt_id", "date_iso", "vendor", "addressee", "tax_breakdown", "total_jpy", "confidence", "issues"],
        "properties": {
          "receipt_id": {"type": "string"},
          "date_iso": {"type": "string", "format": "date"},
          "date_jp_original": {"type": "string"},
          "vendor": {"type": "string"},
          "addressee": {"type": "string"},
          "tax_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rate": {"type": "number"},
                "taxable_amount": {"type": "number"},
                "tax": {"type": "number"}
              }
            }
          },
          "total_jpy": {"type": "number"},
          "total_cny": {"type": "number"},
          "handwritten_notes": {"type": "string"},
          "stamp_present": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "exceptions_md": {"type": "string"}
  }
}
