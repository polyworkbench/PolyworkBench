{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["rca_md", "summary_ko_md", "timeline_kst", "action_items"],
  "properties": {
    "rca_md": {"type": "string", "description": "Full Google-style post-mortem in English"},
    "summary_ko_md": {"type": "string", "description": "1-paragraph Korean executive summary, <= 80 chars"},
    "timeline_kst": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time_kst", "event", "source"],
        "properties": {
          "time_kst": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}(:\\d{2})?$"},
          "event": {"type": "string"},
          "source": {"type": "string", "description": "[source: filename, line N]"},
          "severity": {"type": "string", "enum": ["INFO", "WARN", "ERROR", "CRITICAL"]}
        }
      },
      "minItems": 8
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description_en", "owner", "due_date", "priority"],
        "properties": {
          "id": {"type": "string"},
          "description_en": {"type": "string"},
          "owner": {"type": "string"},
          "due_date": {"type": "string", "format": "date"},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2"]}
        }
      },
      "minItems": 3
    },
    "impact_metrics": {
      "type": "object",
      "properties": {
        "incident_duration_minutes": {"type": "number"},
        "lowest_success_rate": {"type": "number"},
        "estimated_failed_txn_pct": {"type": "number"},
        "peak_kafka_lag": {"type": "integer"},
        "kafka_recovery_minutes": {"type": "number"},
        "mttr_minutes": {"type": "number"},
        "sla_violated": {"type": "boolean"}
      }
    },
    "correlation_analysis": {
      "type": "object",
      "properties": {
        "causal_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {"type": "integer"},
              "event": {"type": "string"},
              "time_kst": {"type": "string"},
              "evidence": {"type": "string"}
            }
          }
        },
        "root_cause": {"type": "string"},
        "contributing_factors": {"type": "array", "items": {"type": "string"}},
        "data_source_cross_references": {"type": "array"}
      }
    }
  }
}
