# LongHorizon Agent Module - Environment Configuration
# Copy this file to .env and fill in your API keys.

# === API Keys ===

# OpenRouter API Key (for OpenRouter models)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model to use
# DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# Judge model for evaluation
# JUDGE_API_KEY=your_judge_api_key_here
# JUDGE_BASE_URL=https://api.anthropic.com
# JUDGE_MODEL=anthropic/claude-sonnet-4-20250514


# === Harness Docker Images (resolved by harness name) ===
# Override the default docker image for each harness.
# If not set, defaults from harness_registry.py are used.
# LONGHORIZON_OPENCLAW_IMAGE=longhorizon-openclaw:v1
# LONGHORIZON_CLAUDECODE_IMAGE=longhorizon-claudecode:v1
# LONGHORIZON_CODEX_IMAGE=longhorizon-codex:v1
# LONGHORIZON_HERMES_IMAGE=longhorizon-hermesagent:v1

# === Global override (applies to ALL harnesses if set) ===
# LONGHORIZON_DOCKER_IMAGE=

# === Proxy (for environments behind firewalls) ===
# HTTP_PROXY_INNER=
# HTTPS_PROXY_INNER=

# === Execution ===
# LONGHORIZON_GATEWAY_PORT=18789
# LONGHORIZON_WORKSPACE_DIR=/workspace
